{
  "mcpServers": {
    "decision": {
      "command": "cmd.exe",
      "args": ["/d", "/c", "scripts\\run.cmd"],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "OPENROUTER_API_KEY",
        "DECISION_ENGINE",
        "DECISION_GUARD_ENGINE",
        "DECISION_PYTHON",
        "DECISION_STATE_DIR",
        "DECISION_SITE_PACKAGES",
        "DECISION_VENV",
        "DECISION_KEY_FILE",
        "JEV_ENGINE",
        "JEV_GUARD_ENGINE",
        "AGNES_API_KEY",
        "LOCALAPPDATA",
        "USERPROFILE",
        "HOME",
        "JEV_PYTHON",
        "JEV_STATE_DIR",
        "JEV_SITE_PACKAGES",
        "JEV_VENV",
        "JEV_KEY_FILE",
        "PATH"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 130
    }
  }
}
